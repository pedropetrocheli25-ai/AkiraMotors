rules_version = '2';
// ============================================================
// AKIRA MOTORS — Reglas de Firestore (archivo de referencia)
// Estas reglas NO se publican solas desde GitHub:
// copia TODO este contenido en Firebase Console >
// Firestore Database > Reglas > Publicar.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================
    function isSignedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }


    // =========================================================
    // TIENDA = SOLO CATALOGO. No hay registro de clientes, ni
    // pedidos, ni resenas, ni cupones en la base de datos.
    // Todo lo de abajo es SOLO administrador (datos historicos).
    // =========================================================
    match /users/{uid} {
      allow read, write: if isAdmin();
    }
    match /phones/{phone} {
      allow read, write: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read, write: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // =========================================================
    // ADMINS
    // =========================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================
    // SETTINGS
    //  - Público: la tienda lee tasa, IVA, envío, etc.
    //  - messagesConfig y adminSettings: SOLO admin
    // =========================================================
    match /settings/{docId} {
      // Publico: SOLO lo que la tienda necesita para mostrar el catalogo
      allow read: if docId in ['bcvRate', 'logo', 'pickupMaps',
                               'siteConfig', 'whatsapp', 'catalogo',
                               'deliveryConfig', 'appSettings',
                               'flashSales', 'aboutUs']
                  || isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================
    // CATÁLOGO
    // =========================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Costos y márgenes: PRIVADOS
    match /productCosts/{productId} {
      allow read, write: if isAdmin();
    }

    match /productImages/{productId} {
      allow read, write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /carouselSlides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deliveryZones/{zoneId} {
      allow read, write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // =========================================================
    // SISTEMA INTERNO: INVENTARIO, COMPRAS Y CAJA (POS)
    // Todo SOLO para administrador.
    //  - purchases: facturas de compra a proveedores
    //  - costHistory: historial de costo/precio por producto
    //  - stockMovements: kárdex (quién cambió qué stock y cuándo)
    //  - sales: ventas de caja (mostrador)
    // =========================================================
    match /purchases/{id} {
      allow read, write: if isAdmin();
    }
    match /costHistory/{id} {
      allow read, write: if isAdmin();
    }
    match /stockMovements/{id} {
      allow read, write: if isAdmin();
    }
    match /sales/{id} {
      allow read, write: if isAdmin();
    }
    match /clients/{id} {
      allow read, write: if isAdmin();
    }
    match /bcvHistory/{id} {
      allow read, write: if isAdmin();
    }
    match /cashCloses/{id} {
      allow read, write: if isAdmin();
    }
  }
}
