rules_version = '2';
// Copia TODO este contenido en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Cualquier personal autorizado (dueño o cajero)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    // Solo el dueño (admins sin role, o con role distinto de 'cajero')
    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'dueno') != 'cajero';
    }

    // Datos históricos de la tienda anterior: solo dueño
    match /users/{id} { allow read, write: if isOwner(); }
    match /phones/{id} { allow read, write: if isOwner(); }
    match /reviews/{id} { allow read, write: if isOwner(); }
    match /coupons/{id} { allow read, write: if isOwner(); }
    match /orders/{id} { allow read, write: if isOwner(); }
    match /deliveryZones/{id} { allow read, write: if isOwner(); }
    match /drivers/{id} { allow read, write: if isOwner(); }
    match /customers/{id} { allow read, write: if isOwner(); }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isOwner();
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if docId in ['bcvRate', 'logo', 'pickupMaps', 'siteConfig', 'whatsapp',
                               'catalogo', 'deliveryConfig', 'appSettings', 'flashSales', 'aboutUs']
                  || isAdmin();
      allow write: if isOwner();
      // El cajero solo puede avanzar el contador de facturas
      allow create, update: if isAdmin() && docId == 'adminSettings'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleCounter']);
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
      // El cajero solo puede descontar stock al vender
      // y nunca puede SUBIR el stock (solo bajarlo); la sincronización de cajas también solo baja
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'packSynced'])
        && (!('stock' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.stock <= resource.data.stock);
    }
    // El cajero necesita leer el costo para registrar la ganancia de la venta
    match /productCosts/{id} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    match /productImages/{id} { allow read, write: if isOwner(); }
    match /brands/{id} { allow read: if true; allow write: if isOwner(); }
    match /carouselSlides/{id} { allow read: if true; allow write: if isOwner(); }

    match /purchases/{id} { allow read, write: if isOwner(); }
    // Historiales: se pueden agregar pero no editar ni borrar
    match /costHistory/{id} { allow read, create: if isOwner(); allow update, delete: if false; }
    match /bcvHistory/{id} { allow read, create: if isOwner(); allow update, delete: if false; }

    // Registro de actividad: cualquier usuario del sistema agrega; solo el dueño lee; nadie edita ni borra
    match /auditLog/{id} {
      allow read: if isOwner();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /expenses/{id} { allow read, write: if isOwner(); }

    match /stockMovements/{id} {
      allow read: if isOwner();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    // Ventas: nunca se borran. El dueño solo puede anularlas o registrar devoluciones (no cambiar otros datos).
    match /sales/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'completed';
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'voidReason', 'voidedBy', 'voidedAt', 'items', 'subtotal', 'discount', 'totalUsd', 'totalBs',
           'costUsd', 'profitUsd', 'refunds']);
      allow delete: if false;
    }
    match /clients/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isOwner();
    }
    match /quotes/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if isOwner();
    }
    // Cuentas por cobrar (fiado/apartado) y sus abonos
    match /receivables/{id} {
      allow read, create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidUsd', 'balanceUsd', 'status', 'lastPaymentAt', 'delivered', 'deliveredAt']);
      allow delete: if false;
    }
    match /receivablePayments/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /cashOpenings/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /cashCloses/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
