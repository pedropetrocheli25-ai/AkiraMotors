rules_version = '2';
// Copia TODO este contenido en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Cualquier personal autorizado (dueño o cajero)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    // Solo el dueño (admins sin role, o con role distinto de 'cajero')
    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'dueno') != 'cajero';
    }

    // Datos históricos de la tienda anterior: solo dueño
    match /users/{id} { allow read, write: if isOwner(); }
    match /phones/{id} { allow read, write: if isOwner(); }
    match /reviews/{id} { allow read, write: if isOwner(); }
    match /coupons/{id} { allow read, write: if isOwner(); }
    match /orders/{id} { allow read, write: if isOwner(); }
    match /deliveryZones/{id} { allow read, write: if isOwner(); }
    match /drivers/{id} { allow read, write: if isOwner(); }
    match /customers/{id} { allow read, write: if isOwner(); }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isOwner();
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if docId in ['bcvRate', 'logo', 'pickupMaps', 'siteConfig', 'whatsapp',
                               'catalogo', 'deliveryConfig', 'appSettings', 'flashSales', 'aboutUs']
                  || isAdmin();
      allow write: if isOwner();
      // El cajero solo puede avanzar el contador de facturas
      allow create, update: if isAdmin() && docId == 'adminSettings'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleCounter']);
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
      // El cajero solo puede descontar stock al vender
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
    }
    // El cajero necesita leer el costo para registrar la ganancia de la venta
    match /productCosts/{id} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    match /productImages/{id} { allow read, write: if isOwner(); }
    match /brands/{id} { allow read: if true; allow write: if isOwner(); }
    match /carouselSlides/{id} { allow read: if true; allow write: if isOwner(); }

    match /purchases/{id} { allow read, write: if isOwner(); }
    match /costHistory/{id} { allow read, write: if isOwner(); }
    match /bcvHistory/{id} { allow read, write: if isOwner(); }

    match /stockMovements/{id} {
      allow read: if isOwner();
      allow create: if isAdmin();
      allow update, delete: if isOwner();
    }
    match /sales/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if isOwner();
    }
    match /clients/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isOwner();
    }
    match /cashCloses/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if isOwner();
    }
  }
}
